<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ServiceFramework_2.13</artifactId>
        <groupId>net.csdn</groupId>
        <version>2.0.9</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>serviceframework-mongo_2.13</artifactId>
    <name>serviceframework-mongo_2.13</name>

    <dependencies>
        <dependency>
            <groupId>net.csdn</groupId>
            <artifactId>serviceframework-common_2.13</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- mongodb-driver-legacy keeps the com.mongodb.DB / DBCollection /
             DBCursor / MongoClient API this module exposes. It needs
             mongodb-driver-core, mongodb-driver-sync and bson at runtime;
             com.mongodb.Mongo no longer exists, so the client type is
             MongoClient. Class file major version stays 52 (Java 8).
             bson-record-codec is excluded: it is the driver-core optional
             Java 17 Record codec (class major 61). The legacy Document API
             this module distributes does not include that extension, and
             driver-core probes for it reflectively, catching
             ClassNotFoundException/UnsupportedClassVersionError when absent. -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-legacy</artifactId>
            <version>5.13.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.mongodb</groupId>
                    <artifactId>bson-record-codec</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Driver POM declares slf4j-api optional, so Maven does not bring it.
             1.7.32 is the API only (class major 49). The application chooses a binding. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.32</version>
        </dependency>
    </dependencies>

</project>
